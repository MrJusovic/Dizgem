@model CommentViewModel

<div class="comment-item mb-3" id="comment-@Model.Id">
    <div class="d-flex">
        <div class="flex-shrink-0">
            <!-- Gravatar veya varsayılan avatar eklenebilir -->
            <img src="data:image/jpeg;base64," class="rounded-circle" width="50" alt="@Model.AuthorName" />
        </div>
        <div class="ms-3 flex-grow-1">
            <div class="fw-bold">@Model.AuthorName</div>
            <div class="text-muted small">@Model.TimeAgo</div>
            <p class="mt-2">@Model.Content</p>
            <button class="btn btn-sm btn-link text-decoration-none" onclick="setReplyTo('@Model.Id')">Yanıtla</button>
        </div>
    </div>

    <!-- Cevaplar (Replies) - İç içe yapı -->
    @if (Model.Replies.Any())
    {
        <div class="replies ps-5 mt-3">
            @foreach (var reply in Model.Replies)
            {
                <partial name="_CommentItemPartial" model="reply" />
            }
        </div>
    }
</div>

@* Sadece bu partial için gerekli olan script.
   Bu script'i ana _Layout.cshtml dosyanızın script bölümüne taşımak daha iyi bir pratiktir.
*@
<script>
    function setReplyTo(parentId) {
        document.getElementById('comment-parent-id-input').value = parentId;
        // Kullanıcıya görsel bir geri bildirim vermek için formu hedef alabiliriz
        var form = document.querySelector('.comments-section form');
        form.scrollIntoView({ behavior: 'smooth' });
        form.querySelector('textarea').focus();
    }
</script>


   <script>
    function replyToComment(commentId, authorName) {
        document.getElementById('comment-parent-id').value = commentId;
        document.getElementById('reply-to-text').innerText = `'${authorName}' adlı kullanıcıya yanıt veriyorsunuz.`;
        document.getElementById('reply-to-info').style.display = 'flex';
        // Forma odaklan
        document.getElementById('comment-form').scrollIntoView({ behavior: 'smooth' });
    }

    function cancelReply() {
        document.getElementById('comment-parent-id').value = '';
        document.getElementById('reply-to-info').style.display = 'none';
    }
</script>