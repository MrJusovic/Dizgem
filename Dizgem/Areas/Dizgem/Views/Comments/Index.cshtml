
@{
    ViewData["Title"] = "Yorumlar";
}
@functions {
    public string GetAntiXsrfRequestToken()
    {
        return Xsrf.GetAndStoreTokens(Context).RequestToken;
    }
}
@section styles {
    <link href="~/lib/DataTables/datatables.min.css" rel="stylesheet" type="text/css" media="all" />
}

<div class=" shadow-none position-relative overflow-hidden mb-4 card">
    <div class="card-body">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h4 class=" mb-0">
                <span class="lstick d-inline-block align-middle"></span> @ViewData["Title"]
            </h4>
            <nav aria-label="breadcrumb" class="d-flex align-items-center">
                <ol class="breadcrumb">
                    @* <li class="breadcrumb-item"><a asp-area="Dizgem" asp-controller="Posts" asp-action="Upsert" class="btn btn-primary">Yeni Yazı Oluştur</a></li> *@
                </ol>
            </nav>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">
            </div>
            <div class="card-body">
                <table id="commentsTable" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>Yazar</th>
                            <th>Yorum</th>
                            <th>Kaynak</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th data-orderable="false" style="width: 200px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/DataTables/pdfmake-0.1.36/pdfmake.min.js"></script>
    <script src="~/lib/DataTables/pdfmake-0.1.36/vfs_fonts.js"></script>
    <script src="~/lib/DataTables/datatables.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#commentsTable').DataTable({
                dom: '<"clearfix d-flex justify-content-around mb-3"<"w-100"f>B><"clearfix overflow-auto"t><"px-3 border-0 d-flex flex-column flex-lg-row align-items-center justify-content-between"<li>p>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        autoFilter: true
                    }
                ],
                "processing": true,
                "serverSide": true,
                "filter": true,
                "order": [[3, "desc"]],
                "ajax": {
                    "url": "/Dizgem/Comments/LoadCommentsData",
                    "type": "POST",
                    "datatype": "json",
                    "headers": {
                        'RequestVerificationToken': '@GetAntiXsrfRequestToken()'
                    }
                },
                "columns": [
                    { "data": "authorName", "name": "AuthorName" },
                    { "data": "content", "name": "Content" },
                    { "data": "source", "name": "Source" },
                    { "data": "createdAt", "name": "CreatedAt" },
                    {
                        "data": "isApproved",
                        "render": function (data, type, row) {
                            return data ? '<span class="badge bg-success">Onaylandı</span>' : '<span class="badge bg-warning">Beklemede</span>';
                        }
                    },
                    {
                        "data": "id",
                        "render": function (data, type, row) {
                            var detailUrl = '/Dizgem/Comments/Detail/' + data;
                            var approvalText = row.isApproved ? 'Onayı Kaldır' : 'Onayla';
                            var approvalClass = row.isApproved ? 'btn-outline-warning' : 'btn-outline-success';

                            return `
                                <div class="btn-group w-100">
                                    <button class="btn btn-sm ${approvalClass} toggle-approval" data-id="${data}">${approvalText}</button>
                                    <a href="${detailUrl}" class="btn btn-sm btn-outline-info">Detay</a>
                                    <button class="btn btn-sm btn-outline-danger delete-comment" data-id="${data}">Sil</button>
                                </div>`;
                        }
                    }
                ],
                "language": {
                    "url": "/lib/DataTables/i18n/tr-TR.json"
                }
            });

            // Onay durumunu değiştirme
            $('#commentsTable').on('click', '.toggle-approval', function () {
                var button = $(this);
                var commentId = button.data('id');

                $.ajax({
                    url: '/Dizgem/Comments/ToggleApproval',
                    type: 'POST',
                    data: { id: commentId },
                    headers: { 'RequestVerificationToken': '@GetAntiXsrfRequestToken()' },
                    success: function (result) {
                        if (result.success) {
                            table.ajax.reload(null, false); // Sayfa yenilemeden tabloyu güncelle
                        } else {
                            alert(result.message || 'İşlem sırasında bir hata oluştu.');
                        }
                    }
                });
            });

            // Yorum Silme
            $('#commentsTable').on('click', '.delete-comment', function () {
                var commentId = $(this).data('id');

                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu yorumu (ve tüm yanıtlarını) silmek üzeresiniz. Bu işlem geri alınamaz!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Dizgem/Comments/Delete',
                            type: 'POST',
                            data: { id: commentId },
                            headers: { 'RequestVerificationToken': '@GetAntiXsrfRequestToken()' },
                            success: function (result) {
                                if (result.success) {
                                    Swal.fire('Silindi!', result.message, 'success');
                                    table.ajax.reload(null, false);
                                } else {
                                    Swal.fire('Hata!', result.message, 'error');
                                }
                            }
                        });

                    }
                })
            });
        });
    </script>
}