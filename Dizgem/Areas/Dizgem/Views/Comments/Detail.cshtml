@model Comment
@{
    ViewData["Title"] = "Yorum Detayı";
}

<div class=" shadow-none position-relative overflow-hidden mb-4 card">
    <div class="card-body">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h4 class=" mb-0">
                <span class="lstick d-inline-block align-middle"></span> @ViewData["Title"]
            </h4>
            <nav aria-label="breadcrumb" class="d-flex align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Dizgem" asp-action="Index" asp-controller="Comments">Yorum Yönetimi</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detay</li>
                </ol>
            </nav>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                Yorum Bilgileri
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-3">Durum</dt>
                                    <dd class="col-sm-9">
                                        @if (Model.IsApproved)
                                        {
                                            <span class="badge bg-success">Onaylandı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Onay Bekliyor</span>
                                        }
                                    </dd>

                                    <dt class="col-sm-3">Yazar Adı</dt>
                                    <dd class="col-sm-9">@Model.AuthorName</dd>

                                    <dt class="col-sm-3">Yazar E-posta</dt>
                                    <dd class="col-sm-9">@Model.AuthorEmail</dd>

                                    <dt class="col-sm-3">Tarih</dt>
                                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm:ss")</dd>

                                    <dt class="col-sm-3">Kaynak</dt>
                                    <dd class="col-sm-9">
                                        @if (Model.PostId.HasValue)
                                        {
                                            <a asp-controller="Post" asp-action="Detail" asp-area="" asp-route-slug="@Model.Post.Slug" target="_blank">Yazı: @Model.Post.Title</a>
                                        }
                                        else if (Model.PageId.HasValue)
                                        {
                                            <a asp-controller="Page" asp-action="Detail" asp-area="" asp-route-slug="@Model.Page.Slug" target="_blank">Sayfa: @Model.Page.Title</a>
                                        }
                                        else
                                        {
                                            <span>Genel Yorum</span>
                                        }
                                    </dd>

                                    @if (Model.Parent != null)
                                    {
                                        <dt class="col-sm-3">Yanıtlanan Yorum</dt>
                                        <dd class="col-sm-9">
                                            <a asp-action="Detail" asp-route-id="@Model.ParentId">@Model.Parent.AuthorName: "@(Model.Parent.Content.Length > 50 ? Model.Parent.Content.Substring(0, 50) + "..." : Model.Parent.Content)"</a>
                                        </dd>
                                    }

                                    <dt class="col-sm-3">IP Adresi</dt>
                                    <dd class="col-sm-9">@Model.IpAddress</dd>

                                    <dt class="col-sm-3">Tarayıcı Bilgisi</dt>
                                    <dd class="col-sm-9">@Model.UserAgent</dd>

                                    <dt class="col-sm-12 mt-3">Yorum İçeriği</dt>
                                    <dd class="col-sm-12">
                                        <div class="p-3 bg-light border rounded">
                                            @Model.Content
                                        </div>
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Yorum Listesine Geri Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>