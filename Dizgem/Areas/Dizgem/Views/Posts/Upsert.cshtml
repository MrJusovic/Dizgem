@model PostEditViewModel<Post>

@{
    ViewData["Title"] = Model.Post?.Id == Guid.Empty ? "Yeni Yazı Oluştur" : "Yazıyı Düzenle";
}
@functions {
    public string GetAntiXsrfRequestToken()
    {
        return Xsrf.GetAndStoreTokens(Context).RequestToken;
    }
}

@section styles {
    <link href="~/lib/tom-select/tom-select.css" rel="stylesheet" type="text/css" media="all" />
    <style>
        #cover-photo-preview-container {
            position: relative;
            display: none; /* Başlangıçta gizli */
            border: 1px solid #ddd;
            border-radius: 5px;
            overflow: hidden;
            background-color: #f8f9fa;
        }

        #cover-photo-preview {
            max-width: 100%;
            height: auto;
            max-height: 300px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

        #remove-cover-photo {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 10;
        }

        #cover-photo-selector-placeholder {
            border: 2px dashed #007bff;
            border-radius: 5px;
            padding: 2rem;
            text-align: center;
            cursor: pointer;
            transition: background-color 0.2s ease-in-out;
        }

            #cover-photo-selector-placeholder:hover {
                background-color: rgb(248 249 250 / 2%);
            }
    </style>
}
<div class=" shadow-none position-relative overflow-hidden mb-4 card">
    <div class="card-body">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h4 class=" mb-0">
                <span class="lstick d-inline-block align-middle"></span> @ViewData["Title"]
            </h4>
            <nav aria-label="breadcrumb" class="d-flex align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Dizgem" asp-action="Index" asp-controller="Posts">Yazılar</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detay</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<form asp-area="Dizgem" asp-controller="Posts" asp-action="Upsert" method="post" class="form row">

    <div class="col-md-8">
        <input type="hidden" asp-for="Post.Id" />
        <input type="hidden" asp-for="Post.AuthorId" />
        <input type="hidden" asp-for="Post.PublishedDate" />

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Post.Title" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Post.Title" class="form-control" />
                        <!-- Başlık Öner Butonu -->
                        <button type="button" class="btn btn-outline-secondary ai-action-button" data-action="SuggestTitles" title="AI ile Başlık Önerileri Al">
                            <i class="fas fa-lightbulb"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Post.Title" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <a target="_blank" asp-area="" asp-controller="Post" asp-action="Detail" asp-route-slug="@Model.Post.Slug">@SettingsService.Current.SiteUrl/@Model.Post.Slug</a>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Post.Slug" class="control-label">URL (Slug)</label>
                    <input asp-for="Post.Slug" class="form-control" />
                    <span asp-validation-for="Post.Slug" class="text-danger"></span>
                </div>
                <!-- === AI YARDIMCISI BUTONLARI === -->
                <div class="card mb-3 bg-light">
                    <div class="card-body p-2 d-flex align-items-center flex-wrap gap-2">
                        <small class="text-muted fw-bold me-2">AI Yardımcısı:</small>

                        <!-- Yönerge İpucu Seçimi -->
                        <select id="ai-prompt-hint" class="form-select form-select-sm w-auto me-1" title="Metin iyileştirme için bir stil seçin">
                            <option value="">Genel İyileştirme</option>
                            <option value="MakeFluent">Daha Akıcı Hale Getir</option>
                            <option value="FixGrammar">Dilbilgisi/Yazımı Düzelt</option>
                            <option value="MakeProfessional">Daha Profesyonel Yap</option>
                            <option value="ShortenSimplify">Kısalt ve Basitleştir</option>
                            <option value="MakeEngaging">Daha İlgi Çekici Yap</option>
                            <option value="AdaptForBeginners">Yeni Başlayanlara Uygun Hale Getir</option>
                            <option value="EnrichText">Metni Zenginleştir</option>
                        </select>

                        <button type="button" class="btn btn-outline-primary btn-sm ai-action-button" data-action="ImproveText">
                            <i class="fas fa-magic me-1"></i> Metni İyileştir
                        </button>
                        <button type="button" class="btn btn-outline-info btn-sm ai-action-button" data-action="GenerateSummary">
                            <i class="fas fa-file-alt me-1"></i> Özet/SEO Oluştur
                        </button>
                        <button type="button" class="btn btn-outline-success btn-sm ai-action-button" data-action="GenerateCoverImage">
                            <i class="fas fa-image me-1"></i> Kapak Fotoğrafı Oluştur
                        </button>
                        
                    </div>
                    <div class="align-items-center card-footer d-flex justify-content-center p-0" style="transition: all 0.5s linear;">
                        <div id="ai-loading-indicator" style="display: none;" class="mb-2 me-2 ms-2 mt-2 spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                        <small id="ai-status-message" class="text-muted"></small>
                    </div>
                </div>
                <!-- =============================== -->
                <div class="form-group mb-3">
                    <label asp-for="Post.ContentJson" class="control-label">İçerik</label>
                    <div id="editorjs" style="border: 1px solid #ced4da; border-radius: .25rem; padding: 1rem;"></div>
                    <input type="hidden" asp-for="Post.ContentJson" id="content-output" />
                    <input type="hidden" asp-for="Post.Content" id="content-output2" />
                    <span asp-validation-for="Post.ContentJson" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="form-group mb-3">
                    <label asp-for="Post.Excerpt" class="control-label">Özet</label>
                    <textarea asp-for="Post.Excerpt" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Post.Excerpt" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-bold">SEO Ayarları</div>
            <div class="card-body">
                <div class="form-group mb-2">
                    <label asp-for="Post.SeoTitle">SEO Başlığı</label>
                    <input asp-for="Post.SeoTitle" class="form-control" placeholder="Boş bırakılırsa ana başlık kullanılır..." />
                </div>
                <div class="form-group mb-2">
                    <label asp-for="Post.SeoDescription">SEO Açıklaması</label>
                    <textarea asp-for="Post.SeoDescription" class="form-control" rows="3" placeholder="Boş bırakılırsa özetten oluşturulur..."></textarea>
                </div>
                <div class="form-group">
                    <label asp-for="Post.SeoKeywords">Anahtar Kelimeler</label>
                    <input asp-for="Post.SeoKeywords" class="form-control" placeholder="Virgülle ayırın..." />
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="form-group mb-3">
                    <label asp-for="Post.CoverPhotoMediaId" class="control-label">Kapak Fotoğrafı</label>

                    @* Bu gizli input, sunucuya gönderilecek olan URL'i tutar *@
                    <input type="hidden" asp-for="Post.CoverPhotoMediaId" id="cover-photo-url-input" />

                    @* Resim önizlemesi ve kaldırma butonu için konteyner *@
                    <div id="cover-photo-preview-container">
                        <img id="cover-photo-preview" src="@Model?.Post?.CoverPhoto?.GetSize("full")" alt="Kapak Fotoğrafı Önizlemesi" />
                        <button type="button" id="remove-cover-photo" class="btn btn-danger btn-sm">&times; Kaldır</button>
                    </div>

                    @* Medya Kütüphanesini açan placeholder/buton *@
                    <div id="cover-photo-selector-placeholder" data-bs-toggle="modal" data-bs-target="#mediaLibraryModal">
                        <p>Kapak fotoğrafı seçmek için tıklayın</p>
                        <small class="text-muted">(Kütüphaneden seçin veya yeni yükleyin)</small>
                    </div>

                    <span asp-validation-for="Post.CoverPhotoMediaId" class="text-danger"></span>
                </div>
            </div>
            <div class="card-footer">
                <div class="form-group form-check mb-3 d-flex justify-content-end">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Post.IsPublished" /> Yayınla
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="Post.CommentPolicy" class="form-label"></label>
                    <select asp-for="Post.CommentPolicy" asp-items="Html.GetEnumSelectList<CommentStatus>()" class="form-select">
                    </select>
                    <small class="form-text text-muted">
                        Bu yazı için yorumların durumunu belirleyin. 'Default' seçeneği, sitenin genel yorum ayarını kullanır.
                    </small>
                </div>

                <div class="form-group mt-3 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
                    <input type="submit" value="Kaydet" id="save-button" class="btn btn-primary" />

                </div>
            </div>
        </div>
        <div class="card mb-3 shadow-sm">
            <div class="card-header fw-bold">Kategoriler</div>
            <div class="card-body" style="max-height: 200px; overflow-y: auto;">
                @foreach (var category in Model?.AllCategories ?? [])
                {
                    <div class="form-check">
                        <input class="form-check-input category-checkbox" type="checkbox" name="SelectedCategoryIds" value="@category.Id" id="cat-@category.Id"
                               @(Model?.SelectedCategoryIds != null && Model.SelectedCategoryIds.Contains(category.Id) ? "checked" : "") />
                        <label class="form-check-label" for="cat-@category.Id">@category.Name</label>
                    </div>
                }
                <hr />
                <label class="fw-bold mb-2">Ana Kategori</label>
                <div id="primary-category-options">
                    @* Burası JS ile seçilen kategorilerden doldurulacak *@
                </div>
                <span asp-validation-for="PrimaryCategoryId" class="text-danger"></span>
            </div>
        </div>

        <!-- Etiket Paneli -->
        <div class="card mb-3 shadow-sm">
            <div class="card-header fw-bold">Etiketler</div>
            <div class="card-body">
                <input asp-for="TagsString" id="tags-input" placeholder="Etiketleri virgülle ayırın..." />
            </div>
        </div>
    </div>

</form>

<!-- === AI MODAL PENCERELERİ === -->
<!-- Başlık Önerileri Modalı -->
<div class="modal fade" id="aiSuggestTitlesModal" tabindex="-1" aria-labelledby="aiSuggestTitlesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="aiSuggestTitlesModalLabel">AI Başlık Önerileri</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p>Oluşturulan başlık önerilerinden birini seçin:</p>
                <ul class="list-group" id="title-suggestions-list">
                    <!-- Öneriler buraya yüklenecek -->
                    <li class="list-group-item text-center"><span class="spinner-border spinner-border-sm"></span> Yükleniyor...</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Metin İyileştirme Modalı -->
<div class="modal fade" id="aiImproveTextModal" tabindex="-1" aria-labelledby="aiImproveTextModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="aiImproveTextModalLabel">AI Metin İyileştirme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p>AI tarafından iyileştirilen metni kontrol edin:</p>
                <div id="improved-text-preview" style="max-height: 400px; overflow-y: auto;" class="border border-light-subtle rounded p-3">
                    <!-- İyileştirilmiş metin buraya yüklenecek -->
                    <div class="text-center"><span class="spinner-border spinner-border-sm"></span> Yükleniyor...</div>
                </div>
                <!-- Gizli alan, iyileştirilmiş metni tutmak için -->
                <input type="hidden" id="improved-text-data">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="apply-improved-text">Değişiklikleri Uygula</button>
            </div>
        </div>
    </div>
</div>

<!-- Özet/SEO Oluşturma Modalı -->
<div class="modal fade" id="aiGenerateSummaryModal" tabindex="-1" aria-labelledby="aiGenerateSummaryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="aiGenerateSummaryModalLabel">AI Özet ve SEO Açıklaması</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="generated-summary" class="form-label">Oluşturulan Özet (Excerpt):</label>
                    <textarea id="generated-summary" class="form-control" rows="3" readonly></textarea>
                </div>
                <div class="mb-3">
                    <label for="generated-description" class="form-label">Oluşturulan SEO Açıklaması:</label>
                    <textarea id="generated-description" class="form-control" rows="2" readonly></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="apply-summary-seo">Uygula</button>
            </div>
        </div>
    </div>
</div>

<!-- Kapak Fotoğrafı Oluşturma Modalı -->
<div class="modal fade" id="aiGenerateImageModal" tabindex="-1" aria-labelledby="aiGenerateImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="aiGenerateImageModalLabel">AI Kapak Fotoğrafı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center">
                <p>AI tarafından oluşturulan kapak fotoğrafı:</p>
                <div id="generated-image-preview" class="mb-3">
                    <span class="spinner-border text-primary"></span> Yükleniyor...
                </div>
                <!-- Gizli alan, resim URL'ini tutmak için -->
                <input type="hidden" id="generated-image-url-data">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="apply-generated-image">Fotoğrafı Kullan</button>
            </div>
        </div>
    </div>
</div>
<!-- =========================== -->
@section Scripts {
    <partial name="_MediaLibraryModal" />

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/lib/tom-select/tom-select.complete.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/editorjs-multiblock-selection-plugin"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/header@@latest"></script><!-- Header -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/image@@latest"></script><!-- Image -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/delimiter@@latest"></script><!-- Delimiter -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/list@@latest"></script><!-- List -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/checklist@@latest"></script><!-- Checklist -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/quote@@latest"></script><!-- Quote -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/code@@latest"></script><!-- Code -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/embed@@latest"></script><!-- Embed -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/table@@latest"></script><!-- Table -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/link@@latest"></script><!-- Link -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/warning@@latest"></script><!-- Warning -->
    <script src="https://cdn.jsdelivr.net/npm/editorjs-drag-drop"></script><!-- Drag & Drop -->
    <script src="https://cdn.jsdelivr.net/npm/editorjs-undo"></script><!-- Undo -->

    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/marker@@latest"></script><!-- Marker -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/raw@@latest"></script><!-- RAW Html -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/inline-code@@latest"></script><!-- Inline Code -->
    <!-- Load Editor.js's Core -->
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/editorjs@@latest"></script>
    <script>

        function generateSlug(text) {
            return text.toString().toLowerCase()
                .replace(/ı/g, 'i').replace(/ğ/g, 'g').replace(/ü/g, 'u')
                .replace(/ş/g, 's').replace(/ö/g, 'o').replace(/ç/g, 'c')
                .replace(/\s+/g, '-').replace(/[^\w\-]+/g, '')
                .replace(/\-\-+/g, '-').replace(/^-+/, '').replace(/-+$/, '');
        }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', (event) => {

             // === AI YARDIMCISI ve EDITOR.JS ===
             let editorInstance = null; // Editor.js instance'ını tutmak için global değişken
             // Bootstrap Modal instance'larını saklamak için
             let aiModals = {};

            @{
                        // C# tarafında, JavaScript'e gönderilecek veriyi güvenli bir şekilde hazırlıyoruz.
                        // Eğer ContentJson boş veya null ise, Editor.js'e boş bir obje '{}' gönderiyoruz.
                        // Dolu ise, mevcut JSON verisini olduğu gibi kullanıyoruz.
                        var initialData = string.IsNullOrWhiteSpace(Model?.Post?.ContentJson) ? "{}" : Model?.Post?.ContentJson;
            }

            // Editörümüzü başlatıyoruz
            const editor = new EditorJS({
                autofocus: true,
                holder: 'editorjs',
                tools: {
                    raw: RawTool,
                  header: {
                    class: Header,
                    inlineToolbar: ['marker', 'link'],
                    config: {
                      placeholder: 'Header'
                    },
                    shortcut: 'CMD+SHIFT+H'
                  },

                  /**
                   * Or pass class directly without any configuration
                   */
                image: {
                    class: ImageTool, // Global scope'ta ImageTool objesini kullanır
                    inlineToolbar: true,
                    config: {
                        // Dosya yükleme için backend endpoint'i
                        endpoints: {
                            byFile: '/api/upload/UploadImage', // C# Controller'ımızdaki metodun adresi
                            byUrl: '/api/FetchUrl', // URL ile resim çekme için, şimdilik bunu yazmasanız da olur
                        },
                        uploader: {
                            // IFormFile parametresinin adıyla eşleşmeli
                            param: 'image'
                        }
                    }
                },

                  list: {
                    class: EditorjsList,
                    inlineToolbar: true,
                    config: {
                        defaultStyle: 'unordered'
                    },
                },

                  checklist: {
                    class: Checklist,
                    inlineToolbar: true,
                  },

                  quote: {
                    class: Quote,
                    inlineToolbar: true,
                    config: {
                      quotePlaceholder: 'Enter a quote',
                      captionPlaceholder: 'Quote\'s author',
                    },
                    shortcut: 'CMD+SHIFT+O'
                  },

                  warning: Warning,

                  marker: {
                    class:  Marker,
                    shortcut: 'CMD+SHIFT+M'
                  },

                  code: {
                    class:  CodeTool,
                    shortcut: 'CMD+SHIFT+C'
                  },

                  delimiter: Delimiter,

                  inlineCode: {
                    class: InlineCode,
                    shortcut: 'CMD+SHIFT+C'
                  },

                  linkTool: LinkTool,

                  embed: Embed,

                  table: {
                    class: Table,
                    inlineToolbar: true,
                    shortcut: 'CMD+ALT+T'
                  },

                },
                // Veritabanından gelen mevcut veriyi editöre yükleme
                data: @Html.Raw(initialData),
                onReady: () => {
                    new Undo({ editor });
                    new DragDrop(editor);

                     // === ÖNEMLİ: editorInstance'ı burada ata ===
                    editorInstance = editor;
                    console.log("EditorJS instance assigned.");
                    // Modal instance'larını oluştur
                     aiModals.suggestTitles = new bootstrap.Modal(document.getElementById('aiSuggestTitlesModal'));
                     aiModals.improveText = new bootstrap.Modal(document.getElementById('aiImproveTextModal'));
                     aiModals.generateSummary = new bootstrap.Modal(document.getElementById('aiGenerateSummaryModal'));
                     aiModals.generateImage = new bootstrap.Modal(document.getElementById('aiGenerateImageModal'));
                    // AI Buton olay dinleyicisini editor hazır olduktan SONRA ata
                    attachAiButtonListener();
                }
            });

            // Form gönderilmeden önce editördeki veriyi gizli input'a yaz
            // Formu ve kaydet butonunu DOM'dan alıyoruz
            const saveButton = document.getElementById('save-button');
            const formElement = saveButton.closest('form');

            // Butona tıklandığında çalışacak kodu tanımlıyoruz
            saveButton.addEventListener('click', function(e) {
                e.preventDefault(); // Butonun formu hemen göndermesini engelle

                // Butonu geçici olarak devre dışı bırakıp "Kaydediliyor..." yazalım
                saveButton.disabled = true;
                saveButton.value = "Kaydediliyor...";

                editor.save().then((outputData) => {
                    // Gizli input alanına editör verisini JSON olarak yaz
                    document.getElementById('content-output').value = JSON.stringify(outputData);

                    // Veri yazıldıktan sonra formu programatik olarak gönder
                    formElement.submit();

                }).catch((error) => {
                    console.error('Kaydetme hatası:', error);
                    alert('Yazı kaydedilirken bir hata oluştu. Lütfen konsolu kontrol edin.');

                    // Hata durumunda butonu tekrar aktif hale getir
                    saveButton.disabled = false;
                    saveButton.value = (formElement.action.includes('Edit')) ? 'Kaydet' : 'Oluştur';
                });
            });

            // String'in JSON olup olmadığını kontrol eden yardımcı fonksiyon
            function IsJson(str) {
                if (typeof str !== 'string' || str.trim() === '') return false;
                try {
                    JSON.parse(str);
                } catch (e) {
                    return false;
                }
                return true;
            }

            new MultiBlockSelectionPlugin({
                editor,
                version: EditorJS.version,
                onBeforeToolbarOpen(toolbar) {
                    const dropdown = toolbar.querySelector('.ce-inline-toolbar__dropdown')
                    if (dropdown instanceof HTMLElement) {
                        dropdown.style.display = 'none'
                    }
                    // show only underline
                    toolbar.querySelectorAll('[data-tool]:not([data-tool=underline])').forEach((el) => {
                        if (!(el instanceof HTMLElement)) return
                        el.style.display = 'none'
                    })
                },
                onAfterToolbarClose(toolbar) {
                    const dropdown = toolbar.querySelector('.ce-inline-toolbar__dropdown')
                    if (dropdown instanceof HTMLElement) {
                        dropdown.style.display = ''
                    }
                    toolbar.querySelectorAll('[data-tool]:not([data-tool=underline])').forEach((el) => {
                        if (!(el instanceof HTMLElement)) return
                        el.style.display = ''
                    })
                },
            })

            // === AI YARDIMCISI İŞLEMLERİ ===
             function attachAiButtonListener() {
                $('.ai-action-button').on('click', function() {
                    if (!editorInstance) { /* ... Hata kontrolü ... */ return; }

                    const action = $(this).data('action');
                    const loadingIndicator = $('#ai-loading-indicator');
                    const statusMessage = $('#ai-status-message');
                    const allAiButtons = $('.ai-action-button');

                    statusMessage.text('AI işliyor...'); loadingIndicator.show(); allAiButtons.prop('disabled', true);

                    let textToSend = ''; let promiseForText;

                    promiseForText = editorInstance.save().then(outputData => {
                        let plainText = '';
                        if (outputData && outputData.blocks) {
                            plainText = outputData.blocks.map(block => {
                                switch (block.type) {
                                    case 'paragraph': case 'header': return block.data.text || '';
                                    case 'list': return (block.data.items || []).map(item => `* ${typeof item === 'object' ? (item.content || '') : item}`).join('\n');
                                    case 'checklist': return (block.data.items || []).map(item => `- [${(item.meta && item.meta.checked) ? 'x' : ' '}] ${item.content || ''}`).join('\n');
                                    case 'quote': return `> ${block.data.text || ''}\n> _${block.data.caption || ''}_`;
                                    default: return '';
                                }
                            }).filter(text => text.trim()).join('\n\n');
                        }
                        return plainText.trim();
                    });

                    promiseForText.then(finalTextToSend => {

                        if ((action === 'GenerateCoverImage' || action === 'SuggestTitles') && !finalTextToSend)
                        {
                            Swal.fire('Hata!', 'Lütfen Bu özelliği kullanmadan önce yazıyı oluşturun.', 'error');
                            throw new Error('Lütfen Bu özelliği kullanmadan önce yazıyı oluşturun.');
                            return;
                        }

                        if (!finalTextToSend) {
                            Swal.fire('Hata!', 'İşlenecek metin bulunamadı.', 'error');
                            throw new Error('İşlenecek metin bulunamadı.');
                            return;
                        }
                        return fetch(`/api/AiAssistant/${action}`, { /* ... Fetch ayarları ... */
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': '@GetAntiXsrfRequestToken()'
                            }, body: JSON.stringify({ Text: finalTextToSend, PromptHint: $('#ai-prompt-hint').val() })
                        });
                    })
                    .then(response => response.ok ? response.json() : response.json().then(err => { throw new Error(err.errorMessage || 'API Hatası'); }))
                    .then(result => {
                         if (result.success) {
                            statusMessage.text('AI yanıtı alındı.');
                            switch(action) {
                                case 'ImproveText':
                                   // --- DÜZELTİLMİŞ BÖLÜM ---
                                    if (result.generatedText) {
                                        const cleanText = result.generatedText.replace(/\n/g, '<br>'); // Satır sonlarını <br> yap
                                        $('#improved-text-preview').html(cleanText); // Metni modala yükle
                                        $('#improved-text-data').val(result.generatedText); // Orijinal metni gizli alana kaydet
                                        aiModals.improveText.show(); // Modalı göster
                                    } else {
                                        statusMessage.text('Hata: AI metin üretmedi.');
                                    }
                                    break;
                                case 'SuggestTitles':
                                    const suggestionsList = $('#title-suggestions-list'); suggestionsList.empty();
                                    if (result.suggestions && result.suggestions.length > 0) {
                                        result.suggestions.forEach(title => suggestionsList.append(`<li class="list-group-item list-group-item-action">${title}</li>`));
                                        aiModals.suggestTitles.show();
                                    } else { statusMessage.text('Başlık önerisi bulunamadı.'); }
                                    break;
                                case 'GenerateSummary':
                                     $('#generated-summary').val(result.generatedSummary || ''); // Modaldaki alanları doldur
                                     $('#generated-description').val(result.generatedDescription || '');
                                     aiModals.generateSummary.show(); // Modalı göster
                                    break;
                                case 'GenerateCoverImage':
                                     $('#generated-image-preview').html(`<img src="${result.generatedImageUrl}" class="img-fluid rounded" alt="AI Generated Image">`);
                                     $('#generated-image-url-data').val(result.generatedImageUrl); // Gizli alana kaydet
                                     aiModals.generateImage.show(); // Modalı göster
                                    break;
                            }
                        } else { throw new Error(result.errorMessage || 'Bilinmeyen AI hatası.'); }
                    })
                    .catch(error => { statusMessage.text(`Hata: ${error.message}`); })
                    .finally(() => {  allAiButtons.prop('disabled', false); setTimeout(function() { loadingIndicator.hide(); statusMessage.text(''); }, 5000); });
                }); // promiseForText.then sonu
             } // attachAiButtonListener sonu

             // --- MODAL UYGULAMA BUTONLARI ---
             $('#apply-improved-text').on('click', function() {
                 const newText = $('#improved-text-data').val();
                 if (newText && editorInstance) {
                     const newBlocks = newText.split('\n\n').filter(p => p.trim()).map(p => ({ type: 'paragraph', data: { text: p } }));
                     if (newBlocks.length > 0) {
                         editorInstance.blocks.clear();
                         editorInstance.blocks.render({ blocks: newBlocks }).then(() => {
                             editorInstance.save().then(updatedData => $('#content-output').val(JSON.stringify(updatedData)));
                         });
                     }
                 }
                 aiModals.improveText.hide();
             });

            $('#title-suggestions-list').on('click', '.list-group-item', function() { // Dinamik olarak eklenen elemanlar için olay delegasyonu
                var data = $(this).text();
                 $('#Post_Title').val(data);
                 $('#Post_SeoTitle').val(data);
                 const slugInput = document.getElementById('Post_Slug');
                 slugInput.value = generateSlug(data);
                 aiModals.suggestTitles.hide();
             });

             $('#apply-summary-seo').on('click', function() {
                 $('#Post_Excerpt').val($('#generated-summary').val());
                 $('#Post_SeoDescription').val($('#generated-description').val());
                 aiModals.generateSummary.hide();
             });

             $('#apply-generated-image').on('click', function() {
                 const imageUrl = $('#generated-image-url-data').val();
                 if (imageUrl) {
                    const uploaderElement = document.getElementById('cover-photo-file-input');
                    if (uploaderElement && window.showPreview) {
                         window.showPreview(uploaderElement, imageUrl);
                    } else { console.error("showPreview or uploader not found for cover photo."); }
                 }
                 aiModals.generateImage.hide();
             });

             function showPreview(uploaderElement, url) {
                // Bu fonksiyonun tam implementasyonu _PostFormPhotoPartial.cshtml'de
                // zaten mevcut olan mantığı içermelidir.
                // Örnek:
                 const previewImgId = uploaderElement.dataset.previewImgId;
                const uploaderId = uploaderElement.dataset.uploaderId;
                const previewContainerId = uploaderElement.dataset.previewContainerId;
                const inputId = uploaderElement.dataset.inputId;

                 const urlInput = document.getElementById(inputId);
                const uploaderBox = document.getElementById(uploaderId);
                const previewContainer = document.getElementById(previewContainerId);
                const previewImg = document.getElementById(previewImgId);

                if (urlInput && uploaderBox && previewContainer && previewImg) {
                    if (url) {
                        previewImg.src = url;
                        urlInput.value = url;
                        previewContainer.style.display = 'block';
                        uploaderBox.style.display = 'none';
                    } else { // URL boş ise (örneğin kaldır butonu)
                         urlInput.value = '';
                        previewImg.src = '';
                        previewContainer.style.display = 'none';
                        uploaderBox.style.display = 'block';
                        // uploaderBox'ın içeriğini orijinal haline getirmek isteyebilirsiniz.
                    }
                } else {
                     console.error("showPreview: Gerekli elementler bulunamadı.", {inputId, previewImgId, uploaderId, previewContainerId});
                }
             }
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Kategori seçildiğinde, yanındaki "Ana" radio butonunu aktif/pasif yap
            const primaryCategoryContainer = document.getElementById('primary-category-options');
            function updatePrimaryCategoryOptions() {
                primaryCategoryContainer.innerHTML = ''; // Temizle
                const selectedCheckboxes = document.querySelectorAll('.category-checkbox:checked');

                if (selectedCheckboxes.length === 0) {
                    primaryCategoryContainer.innerHTML = '<small class="text-muted">Önce kategori seçin.</small>';
                    return;
                }

                selectedCheckboxes.forEach(cb => {
                    const label = cb.nextElementSibling;
                    const div = document.createElement('div');
                    div.classList.add('form-check');

                    const isChecked = (cb.value == '@Model.PrimaryCategoryId?.ToString()');

                    div.innerHTML = `<input class="form-check-input" type="radio" name="PrimaryCategoryId" id="primary-cat-${cb.value}" value="${cb.value}" ${isChecked ? 'checked' : ''}>
                                     <label class="form-check-label" for="primary-cat-${cb.value}">${label.textContent}</label>`;
                    primaryCategoryContainer.appendChild(div);
                });
            }
            document.querySelectorAll('.category-checkbox').forEach(cb => cb.addEventListener('change', updatePrimaryCategoryOptions));
            updatePrimaryCategoryOptions(); // Sayfa yüklendiğinde ilk durumu ayarla

            // --- ETİKET YÖNETİMİ (TOM-SELECT) ---
            new TomSelect('#tags-input', {
                persist: false,
                valueField: 'value',
                labelField: 'title',
                searchField: 'title',
                sortField: 'title',
                createOnBlur: true,
                create: true,
                plugins: ['remove_button'],
                options: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model?.AllTags?.Select(t => new { value = t.Name, title = t.Name }) ?? []))
            });


            // Slug oluşturma mantığı
            const titleInput = document.getElementById('Post_Title');
            const slugInput = document.getElementById('Post_Slug');
            if (titleInput && slugInput) {
                titleInput.addEventListener('keyup', function () {
                    slugInput.value = generateSlug(this.value);
                });
            }
        });
    </script>

    <script>
        // === YENİ KAPAK FOTOĞRAFI SEÇİCİ MANTIĞI ===
        (function() {
            const urlInput = document.getElementById('cover-photo-url-input');
            const previewContainer = document.getElementById('cover-photo-preview-container');
            const previewImg = document.getElementById('cover-photo-preview');
            const removeBtn = document.getElementById('remove-cover-photo');
            const selectorPlaceholder = document.getElementById('cover-photo-selector-placeholder');

            // Mevcut bir resim varsa ilgili alanları ayarla
            function updatePreviewVisibility() {
                const hasValue = urlInput.value.trim() !== '';
                previewContainer.style.display = hasValue ? 'block' : 'none';
                selectorPlaceholder.style.display = hasValue ? 'none' : 'block';
            }

            // Resmi kaldırma
            removeBtn.addEventListener('click', () => {
                urlInput.value = '';
                previewImg.src = '';
                updatePreviewVisibility();
            });

            // Medya Kütüphanesinden bir resim seçildiğinde tetiklenen olayı dinle
            // Bu event _MediaLibraryModal.cshtml tarafından fırlatılır
            document.addEventListener('dizgem:media:selected', function (e) {
                const { id, url, thumbnailUrl } = e.detail;
                urlInput.value = id;
                previewImg.src = url; // Önizleme için thumbnail kullan
                updatePreviewVisibility();
            });

            // Sayfa yüklendiğinde ilk durumu ayarla
            updatePreviewVisibility();
        })();
        // =============================================
    </script>

}