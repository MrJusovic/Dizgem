@model Dizgem.Models.LoginViewModel
@{
    Layout = "_GlobalLayout";
    ViewBag.Title = "Login";
}

<div class="authentication-login auth-card-login min-vh-100 min-height-auto bg-white row justify-content-center align-items-center p-4 mx-3 mx-lg-auto mt-5 mt-sm-0">
    <div class="z-index-5">
        <h2 class="mb-1 fs-7 fw-bolder">Dizgem CMS'ya Hoş Geldiniz</h2>
        <p class="mb-4">Lütfen Kullanıcı Bilgilerinizi Yazınız</p>
        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="Username" class="form-label" data-eposta-str>E-Posta Adresi</label>
                @Html.TextBoxFor(x => x.Username, new { @class = "form-control", data_eposta_str = "" })
            </div>
            <div class="mb-4">
                <label for="Password" class="form-label" data-sifre-str>Parola</label>
                @Html.PasswordFor(x => x.Password, new { @class = "form-control", data_sifre_str = "" })
            </div>
            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                <div class="form-check">
                    @Html.CheckBoxFor(x => x.RememberMe, new { @class = "form-check-input primary" })
                    <label class="form-check-label text-dark" for="RememberMe" data-beni-hatirla>
                        Beni Hatırla
                    </label>
                </div>
                <a class="text-primary fw-medium" asp-area="Dizgem" asp-controller="Account" asp-action="ForgotPassword" data-sifremi-unuttum tabindex="-1">
                    Şifremi Unuttum
                </a>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-8 mb-4 rounded-2" data-giris-str>Giriş</button>
        }
        <p class="m-0 text-muted fs-2 text-center" style="cursor: default;">Version : @(System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "0.0.0")</p>
    </div>

</div>