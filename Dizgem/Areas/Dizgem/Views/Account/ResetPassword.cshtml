@model ResetPasswordViewModel
@{
    Layout = "_GlobalLayout";
    ViewBag.Title = "Reset Password";
}

<div class="authentication-login auth-card-login min-vh-100 min-height-auto bg-white row justify-content-center align-items-center p-4 mx-3 mx-lg-auto mt-5 mt-sm-0">
    <div class="d-flex align-items-center w-100 h-100 z-index-5">
        <div class="card-body">
            <div class="mb-3">
                <h3 class="fw-bolder fs-7 mb-3">Şifremi Unuttum</h3>
                <p>
                    Lütfen hesabınızla ilişkili e-posta adresini girin. Şifrenizi sıfırlamak için size bir bağlantı göndereceğiz.
                </p>
            </div>
            <form asp-area="Dizgem" asp-action="ResetPassword" asp-controller="Account" method="post" class="mb-3">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Code" />
                <input type="hidden" asp-for="Email" />
                <div class="form-group mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Şifreyi Sıfırla</button>
            </form>
            <p class="m-0 text-muted fs-2 text-center" style="cursor: default;">Version : @(System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "0.0.0")</p>
        </div>
    </div>
</div>