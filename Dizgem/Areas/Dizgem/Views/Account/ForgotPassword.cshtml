@model ForgotPasswordViewModel
@{
    Layout = "_GlobalLayout";
    ViewBag.Title = "Forgot Password";
}

<div class="authentication-login auth-card-login min-vh-100 min-height-auto bg-white row justify-content-center align-items-center p-4 mx-3 mx-lg-auto mt-5 mt-sm-0">
    <div class="d-flex align-items-center w-100 h-100 z-index-5">
        <div class="card-body">
            <div class="mb-3">
                <h3 class="fw-bolder fs-7 mb-3">Şifremi Unuttum</h3>
                <p>
                    Lütfen hesabınızla ilişkili e-posta adresini girin. Şifrenizi sıfırlamak için size bir bağlantı göndereceğiz.
                </p>
            </div>
            <form asp-area="Dizgem" asp-action="ForgotPassword" asp-controller="Account" method="post" class="mb-3">
                <div class="mb-3">
                    <div class="form-group mt-2">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-8 mb-4">Şifremi Sıfırla</button>
                <a asp-area="Dizgem" asp-controller="Account" asp-action="Login" class="btn bg-primary-subtle text-primary w-100 py-8">
                    Girişe Dön
                </a>
            </form>
            <p class="m-0 text-muted fs-2 text-center" style="cursor: default;">Version : @(System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "0.0.0")</p>
        </div>
    </div>
</div>