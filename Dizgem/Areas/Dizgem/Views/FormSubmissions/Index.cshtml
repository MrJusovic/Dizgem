
@{
    ViewData["Title"] = "Index";
}

@functions {
    public string GetAntiXsrfRequestToken()
    {
        return Xsrf.GetAndStoreTokens(Context).RequestToken;
    }
}

@section styles {
    <link href="~/lib/DataTables/datatables.min.css" rel="stylesheet" type="text/css" media="all" />
}

@{
    ViewData["Title"] = $"'{ViewData["FormHandlerName"]}' Form Kayıtları";
}

<div class=" shadow-none position-relative overflow-hidden mb-4 card">
    <div class="card-body">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h4 class=" mb-0">
                <span class="lstick d-inline-block align-middle"></span> Form Kayıtları
            </h4>
            <nav aria-label="breadcrumb" class="d-flex align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Dizgem" asp-action="Index" asp-controller="Forms">Form İşleyicileri</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                </ol>
            </nav>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <table id="submissionsTable" class="table table-striped table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>Gönderim Tarihi</th>
                            <th>Veri Önizleme</th>
                            <th data-orderable="false">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/DataTables/pdfmake-0.1.36/pdfmake.min.js"></script>
    <script src="~/lib/DataTables/pdfmake-0.1.36/vfs_fonts.js"></script>
    <script src="~/lib/DataTables/datatables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#submissionsTable').DataTable({
                dom: '<"clearfix d-flex justify-content-around mb-3"<"w-100"f>B><"clearfix overflow-auto"t><"px-3 border-0 d-flex flex-column flex-lg-row align-items-center justify-content-between"<li>p>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        autoFilter: true
                    }
                ],
                "processing": true,
                "serverSide": true,
                "filter": true,
                "order": [[0, "desc"]],
                "ajax": {
                    "url": "/Dizgem/FormSubmissions/LoadSubmissionsData",
                    "type": "POST",
                    "datatype": "json",
                    "data": {
                        "formHandlerId": "@ViewData["FormHandlerId"]",
                        "__RequestVerificationToken": "@GetAntiXsrfRequestToken()"
                    }
                },
                "columns": [
                    { "data": "submissionDate", "name": "SubmissionDate", "autoWidth": true },
                    { "data": "dataPreview", "name": "DataPreview", "autoWidth": true },
                    {
                        "data": "id",
                        "render": function (data, type, row, meta) {
                            var detailUrl = '/Dizgem/FormSubmissions/Detail/' + data;
                            return `<a href="${detailUrl}" class="btn btn-sm btn-info">Detayları Gör</a>`;
                        }
                    }
                ],
                "language": {
                    "url": "/lib/DataTables/i18n/tr-TR.json"
                }
            });
        });
    </script>
}