
@{
    ViewData["Title"] = "Form İşleyicileri";
}

@section styles {
    <link href="~/lib/DataTables/datatables.min.css" rel="stylesheet" type="text/css" media="all" />
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>@ViewData["Title"]</h4>
    <a asp-action="Create" class="btn btn-primary">Yeni İşleyici Ekle</a>
</div>

<!-- Bildirim Mesajları -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <table id="handlersTable" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Adı</th>
                    <th>Aksiyon Türü</th>
                    <th>Aksiyon Hedefi</th>
                    <th>Benzersiz ID</th>
                    <th data-orderable="false" style="width:150px;">İşlemler</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/DataTables/pdfmake-0.1.36/pdfmake.min.js"></script>
    <script src="~/lib/DataTables/pdfmake-0.1.36/vfs_fonts.js"></script>
    <script src="~/lib/DataTables/datatables.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#handlersTable').DataTable({
                dom: '<"clearfix d-flex justify-content-around mb-3"<"w-100"f>B><"clearfix overflow-auto"t><"px-3 border-0 d-flex flex-column flex-lg-row align-items-center justify-content-between"<li>p>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        autoFilter: true
                    }
                ],
                "processing": true,
                "serverSide": true,
                "filter": true,
                "ajax": {
                    "url": "@Url.Action("LoadData", "Forms", new { area = "Dizgem" })",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "name", "name": "Name" },
                    {
                        "data": "actionType",
                        "render": function (data) {
                            return data === 1 ? "E-posta Gönder" : "Veritabanına Kaydet";
                        }
                    },
                    { "data": "actionTarget", "name": "ActionTarget" },
                    { "data": "uniqueIdentifier", "name": "UniqueIdentifier" },
                    {
                        "data": "id",
                        "render": function (data, type, row) {
                            var editUrl = '@Url.Action("Edit")/' + data;
                            return `<a href="${editUrl}" class="btn btn-sm btn-info">Düzenle</a> ` +
                                   `<button type="button" class="btn btn-sm btn-danger delete-btn" data-id="${data}" data-name="${row.name}">Sil</button>`;
                        }
                    }
                ],
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" }
            });

            $('#handlersTable').on('click', '.delete-btn', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var token = $('input[name="__RequestVerificationToken"]').val();

                Swal.fire({
                    title: `'${name}' işleyicisini silmek istediğinizden emin misiniz?`,
                    text: "Bu işlem geri alınamaz!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("Delete")/' + id,
                            type: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Silindi!', response.message, 'success');
                                    table.ajax.reload();
                                } else {
                                    Swal.fire('Hata!', response.message, 'error');
                                }
                            },
                            error: function () {
                                Swal.fire('Hata!', 'İşlem sırasında bir hata oluştu.', 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}


