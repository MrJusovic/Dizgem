@model FormHandler
@{
    ViewData["Title"] = "Form İşleyiciyi Düzenle";
}

<div class=" shadow-none position-relative overflow-hidden mb-4 card">
    <div class="card-body">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h4 class=" mb-0">
                <span class="lstick d-inline-block align-middle"></span> @ViewData["Title"]
            </h4>
            <nav aria-label="breadcrumb" class="d-flex align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-area="Dizgem" asp-action="Index" asp-controller="Forms">Form İşleyiciler</a></li>
                    <li class="breadcrumb-item"><a asp-area="Dizgem" asp-action="Edit" asp-controller="Forms" asp-route-id="@Model.Id">@Model.Name</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detay</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header">
            </div>
            <div class="card-body">
                <form asp-area="Dizgem" asp-controller="Forms" asp-action="Edit">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UniqueIdentifier" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label>Benzersiz Tanımlayıcı (Değiştirilemez)</label>
                        <input asp-for="UniqueIdentifier" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label asp-for="ActionType" class="form-label"></label>
                        <select asp-for="ActionType" asp-items="Html.GetEnumSelectList<FormActionType>()" class="form-select"></select>
                        <span asp-validation-for="ActionType" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ActionTarget" class="form-label"></label>
                        <input asp-for="ActionTarget" class="form-control" />
                        <span asp-validation-for="ActionTarget" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SuccessMessage" class="form-label"></label>
                        <textarea asp-for="SuccessMessage" class="form-control"></textarea>
                        <span asp-validation-for="SuccessMessage" class="text-danger"></span>
                    </div>
                    <div class="form-group d-flex justify-content-between">
                        <a asp-action="Index" asp-controller="Forms" asp-area="Dizgem" class="btn btn-secondary">Geri Dön</a>
                        <input type="submit" value="Kaydet" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
