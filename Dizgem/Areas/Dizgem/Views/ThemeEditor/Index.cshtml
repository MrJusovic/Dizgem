@model List<ThemeFileNodeViewModel>
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@{
    ViewData["Title"] = "Tema Düzenleyici";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/codemirror.min.css" type="text/css" media="all" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/theme/material-darker.min.css" type="text/css" media="all" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.15/addon/dialog/dialog.css" type="text/css" media="all" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.15/addon/search/matchesonscrollbar.css" type="text/css" media="all" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        .CodeMirror {
            height: 100%;
            font-size: 14px;
        }

        #theme-tree-container a {
            text-decoration: none;
            color: inherit;
            display: block;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
        }

            #theme-tree-container a:hover {
                background-color: #f0f0f0;
                color: #212121;
            }

        #theme-tree-container .file-link.active, #theme-tree-container .toggle-folder.active {
            background-color: #0d6efd;
            color: white;
        }

        #theme-tree-container .toggle-folder .fa-folder,
        #theme-tree-container .toggle-folder .fa-folder-open {
            color: #f8d775;
        }

        #theme-tree-container .far {
            color: #aaa;
        }

        .CodeMirror-hscrollbar, .CodeMirror-vscrollbar {
           background: rgba(250, 250, 250, 0.2);
        }
    </style>
}

@functions {
    public void RenderTree(List<ThemeFileNodeViewModel> nodes)
    {
        if (nodes == null || !nodes.Any()) return;

        <ul class="list-unstyled ps-3">
            @foreach (var node in nodes)
            {
                <li>
                    @if (node.IsDirectory)
                    {
                        <a href="#" class="toggle-folder @(node.IsOpen ? "open" : "")"
                           data-bs-toggle="collapse"
                           data-bs-target="#folder-@node.Path.GetHashCode()"
                           data-path="@node.Path">
                            @* data-path eklendi *@
                            <i class="fas fa-folder @(node.IsOpen ? "fa-folder-open" : "")"></i> @node.Name
                        </a>
                        <div id="folder-@node.Path.GetHashCode()" class="collapse @(node.IsOpen ? "show" : "")">
                            @{
                                RenderTree(node.Children);
                            }
                        </div>
                    }
                    else
                    {
                        <a href="#" class="file-link" data-path="@node.Path">
                            <i class="far fa-file-alt"></i> @node.Name
                        </a>
                    }
                </li>
            }
        </ul>
    }
}

<div class=" shadow-none position-relative overflow-hidden mb-4 card">
    <div class="card-body">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h4 class=" mb-0">
                <span class="lstick d-inline-block align-middle"></span> @ViewData["Title"]
            </h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 col-12" id="theme-tree-container">
                        <!-- YENİ BUTONLAR -->
                        <div class="mb-2 d-grid gap-2 d-md-flex">
                            <button id="new-folder-btn" class="btn btn-sm btn-outline-secondary w-100" title="Yeni Klasör"><i class="fas fa-folder-plus"></i> Klasör</button>
                            <button id="new-file-btn" class="btn btn-sm btn-outline-secondary w-100" title="Yeni Dosya"><i class="fa-file-plus fad"></i> Dosya</button>
                            <button id="upload-file-btn" class="btn btn-sm btn-outline-success w-100" title="Dosya Yükle" disabled><i class="fas fa-upload"></i></button>
                            <button id="rename-btn" class="btn btn-sm btn-outline-secondary w-100" title="Yeniden Adlandır" disabled><i class="fas fa-pencil-alt"></i></button>
                            <button id="delete-btn" class="btn btn-sm btn-outline-danger w-100" title="Sil" disabled><i class="fas fa-trash-alt"></i></button>
                        </div>
                        <input type="file" id="file-upload-input" style="display: none;" />
                        <hr />
                        <!-- /YENİ BUTONLAR -->
                        @{
                            RenderTree(Model);
                        }
                    </div>
                    <div class="col-md-9">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span id="editing-file-name">Dosya Seçin</span>
                                <div>
                                    <button id="beautify-btn" class="btn btn-sm btn-outline-secondary" disabled>Beautify</button>
                                    <button id="save-btn" class="btn btn-sm btn-primary" disabled>Kaydet</button>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div id="editor-container" style="height: 70vh;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {

    <!-- Gerekli JS Kütüphaneleri -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/mode/xml/xml.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/mode/css/css.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/mode/javascript/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/mode/clike/clike.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/mode/htmlmixed/htmlmixed.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/addon/selection/active-line.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/addon/search/search.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/addon/search/searchcursor.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/addon/dialog/dialog.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/addon/search/jump-to-line.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/6.65.7/addon/search/match-highlighter.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/js-beautify/1.14.7/beautify.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/js-beautify/1.14.7/beautify-css.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/js-beautify/1.14.7/beautify-html.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let editor;
            let currentFilePath = null;
            let currentSelectedPath = null; // Seçili olan düğümün yolunu tutar
            let currentSelectedNodeType = null; // 'file' veya 'folder'
            let currentMode = null;
            const editorContainer = document.getElementById('editor-container');
            const saveBtn = document.getElementById('save-btn');
            const beautifyBtn = document.getElementById('beautify-btn');
            const editingFileName = document.getElementById('editing-file-name');
            const renameBtn = document.getElementById('rename-btn'); // Rename butonu
            const deleteBtn = document.getElementById('delete-btn');
            const uploadBtn = document.getElementById('upload-file-btn');
            const fileUploadInput = document.getElementById('file-upload-input');

            // CodeMirror'ı başlat
            editor = CodeMirror(editorContainer, {
                lineNumbers: true,
                theme: 'material-darker',
                readOnly: true, // Başlangıçta salt okunur
                styleActiveLine: true, // Aktif satırı vurgula
                highlightSelectionMatches: { showToken: /\w/ }, // Eşleşen kelimeleri vurgula
                extraKeys: {
                    "Ctrl-F": "findPersistent", // Kalıcı arama kutusu (Ctrl+F)
                    "F3": "findNext",
                    "Shift-F3": "findPrev",
                    "Ctrl-G": "jumpToLine" // Satıra git (Ctrl+G)
                }
            });

            // --- YENİ: Seçimi izlemek için ---
            document.querySelectorAll('.file-link, .toggle-folder').forEach(link => {
                link.addEventListener('click', function(e) {
                    // Tüm aktif sınıfları kaldır
                    document.querySelectorAll('.file-link, .toggle-folder').forEach(l => l.classList.remove('active'));
                    // Tıklanana ekle
                    this.classList.add('active');

                    currentSelectedPath = this.dataset.path;
                    currentSelectedNodeType = this.classList.contains('file-link') ? 'file' : 'folder';

                    var element = document.getElementById(this.attributes['data-bs-target']['value'].toString().replace('#', ''));

                    if(element.classList.contains('collapsing'))
                    {
                        if(this.children[0].classList.contains('fa-folder-open'))
                        {
                            this.children[0].classList.remove('fa-folder-open');
                            this.children[0].classList.add('fa-folder');
                        }
                        else
                        {
                            this.children[0].classList.add('fa-folder-open');
                            this.children[0].classList.remove('fa-folder');
                        }
                    }

                    const rootThemeName = '@Model.FirstOrDefault()?.Path';
                    const isRootNode = (currentSelectedPath === rootThemeName);

                    renameBtn.disabled = isRootNode; // Seçim yapıldığında rename butonunu aktif et
                    deleteBtn.disabled = isRootNode; // Kök klasörse silme butonunu kapat
                    uploadBtn.disabled = false; // Yüklenecek bir yer seçildiği sürece butonu aç
                });
            });


            // Dosya linklerine tıklama olayı
            document.querySelectorAll('.file-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    currentFilePath = this.dataset.path;
                    editingFileName.textContent = currentFilePath;

                    fetch(`/Dizgem/ThemeEditor/GetFileContent?path=${encodeURIComponent(currentFilePath)}`)
                        .then(response => response.json())
                        .then(data => {
                            if(data.success) {
                                editor.setValue(data.content);
                                editor.setOption("readOnly", false);

                                const extension = currentFilePath.split('.').pop().toLowerCase();
                                switch (extension) {
                                    case 'cshtml': // CSHTML desteği güncellendi
                                    case 'html':
                                        currentMode = 'html';
                                        editor.setOption('mode', 'htmlmixed');
                                        break;
                                    case 'xml':
                                        currentMode = 'xml';
                                        editor.setOption('mode', 'xml');
                                        break;
                                    case 'css':
                                        currentMode = 'css';
                                        editor.setOption('mode', 'css');
                                        break;
                                    case 'js':
                                        currentMode = 'javascript';
                                        editor.setOption('mode', 'javascript');
                                        break;
                                    case 'sql':
                                        currentMode = 'sql';
                                        editor.setOption('mode', 'sql');
                                        break;
                                    case 'php':
                                        currentMode = 'php';
                                        editor.setOption('mode', 'php');
                                        break;
                                    case 'json': // JSON desteği eklendi
                                        currentMode = 'json';
                                        editor.setOption('mode', { name: 'javascript', json: true });
                                        break;
                                    default:
                                        currentMode = 'text';
                                        editor.setOption('mode', null);
                                }
                                saveBtn.disabled = false;
                                beautifyBtn.disabled = currentMode === 'text';

                            } else {
                                Swal.fire('Hata!', 'Hata: ' + data.message, 'error');
                            }
                        });
                });
            });

            // Kaydet butonu
            saveBtn.addEventListener('click', function() {
                if (!currentFilePath) return;

                const content = editor.getValue();
                saveBtn.disabled = true;
                saveBtn.textContent = 'Kaydediliyor...';

                fetch('/Dizgem/ThemeEditor/SaveFileContent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': '@Xsrf.GetAndStoreTokens(Context).RequestToken'
                    },
                    body: JSON.stringify({ path: currentFilePath, content: content })
                })
                .then(response => response.json().then(data => ({ status: response.status, body: data })))
                .then(({ status, body }) => {
                    if (status === 200 && body.success) {
                        Swal.fire('OK', body.message, 'success');
                    } else {
                        throw new Error(body.message || 'Bir hata oluştu.');
                    }
                })
                .catch(error => {
                    Swal.fire('Hata!', 'Hata: ' + error.message, 'error');
                })
                .finally(() => {
                    saveBtn.disabled = false;
                    saveBtn.textContent = 'Kaydet';
                });
            });

            // Beautify butonu
            beautifyBtn.addEventListener('click', function() {
                if (!editor || currentMode === 'text') return;

                const content = editor.getValue();
                let beautifiedContent = content;

                if (currentMode === 'html') {
                    beautifiedContent = html_beautify(content);
                } else if (currentMode === 'css') {
                    beautifiedContent = css_beautify(content);
                } else if (currentMode === 'javascript' || currentMode === 'json') {
                    beautifiedContent = js_beautify(content, { indent_size: 2, space_in_empty_paren: true });
                }

                editor.setValue(beautifiedContent);
            });

            // --- YENİ DOSYA/KLASÖR OLUŞTURMA ---

            document.getElementById('new-file-btn').addEventListener('click', () => createNewNode('file'));
            document.getElementById('new-folder-btn').addEventListener('click', () => createNewNode('folder'));

            function createNewNode(type) {
                let basePath = '';
                if (currentSelectedPath) {
                    // Eğer seçili olan bir dosyaysa, o dosyanın bulunduğu klasörü baz al
                    // Eğer seçili olan bir klasörse, doğrudan o klasörü baz al
                    basePath = (currentSelectedNodeType === 'file') ? currentSelectedPath.substring(0, currentSelectedPath.lastIndexOf('/')) : currentSelectedPath;
                } else {
                    // Hiçbir şey seçili değilse, tema kök dizinini baz al
                    basePath = '@Model.FirstOrDefault()?.Path';
                    if (!basePath) {
                         Swal.fire('Hata', 'Lütfen önce bir dosya veya klasör seçin.', 'error');
                         return;
                    }
                }

                Swal.fire({
                    title: type === 'file' ? 'Yeni Dosya Adı' : 'Yeni Klasör Adı',
                    input: 'text',
                    inputPlaceholder: type === 'file' ? 'yeni-dosya.cshtml' : 'yeni-klasor',
                    showCancelButton: true,
                    confirmButtonText: 'Oluştur',
                    cancelButtonText: 'Vazgeç',
                    inputValidator: (value) => {
                        if (!value) {
                            return 'Bir isim girmelisiniz!'
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed && result.value) {
                        const newName = result.value;
                        const newPath = basePath + '/' + newName;
                        const url = type === 'file' ? '/Dizgem/ThemeEditor/CreateFile' : '/Dizgem/ThemeEditor/CreateFolder';

                        fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': '@Xsrf.GetAndStoreTokens(Context).RequestToken'
                            },
                            body: JSON.stringify({ path: newPath })
                        })
                        .then(response => response.json().then(data => ({ status: response.status, body: data })))
                        .then(({ status, body }) => {
                            if (status === 200 && body.success) {
                                Swal.fire('Başarılı!', body.message, 'success').then(() => {
                                    location.reload(); // Ağacı yenilemek için sayfayı yeniden yükle
                                });
                            } else {
                                throw new Error(body.message || 'Bir hata oluştu.');
                            }
                        })
                        .catch(error => {
                            Swal.fire('Hata!', error.message, 'error');
                        });
                    }
                });
            }

            // --- YENİ YENİDEN ADLANDIRMA ---
            renameBtn.addEventListener('click', function() {
                if (!currentSelectedPath) {
                    Swal.fire('Hata', 'Lütfen yeniden adlandırmak için bir dosya veya klasör seçin.', 'error');
                    return;
                }

                const oldName = currentSelectedPath.substring(currentSelectedPath.lastIndexOf('/') + 1);

                Swal.fire({
                    title: 'Yeniden Adlandır',
                    input: 'text',
                    inputValue: oldName,
                    showCancelButton: true,
                    confirmButtonText: 'Kaydet',
                    cancelButtonText: 'Vazgeç',
                    inputValidator: (value) => {
                        if (!value) return 'Bir isim girmelisiniz!';
                        if (value === oldName) return 'Yeni isim eskisiyle aynı olamaz!';
                    }
                }).then((result) => {
                    if (result.isConfirmed && result.value) {
                        const newName = result.value;
                        const basePath = currentSelectedPath.substring(0, currentSelectedPath.lastIndexOf('/'));
                        const newPath = basePath + '/' + newName;

                        fetch('/Dizgem/ThemeEditor/RenameNode', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': '@Xsrf.GetAndStoreTokens(Context).RequestToken'
                            },
                            body: JSON.stringify({ oldPath: currentSelectedPath, newPath: newPath })
                        })
                        .then(response => response.json().then(data => ({ status: response.status, body: data })))
                        .then(({ status, body }) => {
                            if (status === 200 && body.success) {
                                Swal.fire('Başarılı!', body.message, 'success').then(() => {
                                    location.reload(); // Ağacı yenilemek için sayfayı yeniden yükle
                                });
                            } else {
                                throw new Error(body.message || 'Bir hata oluştu.');
                            }
                        })
                        .catch(error => {
                            Swal.fire('Hata!', error.message, 'error');
                        });
                    }
                });
            });

            deleteBtn.addEventListener('click', function() {
                if (!currentSelectedPath) {
                    Swal.fire('Hata', 'Lütfen silmek için bir dosya veya klasör seçin.', 'error');
                    return;
                }

                Swal.fire({
                    title: 'Emin misiniz?',
                    text: `'${currentSelectedPath}' silinecek. Bu işlem geri alınamaz!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, sil!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch('/Dizgem/ThemeEditor/DeleteNode', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': '@Xsrf.GetAndStoreTokens(Context).RequestToken'
                            },
                            body: JSON.stringify({ path: currentSelectedPath })
                        })
                        .then(response => response.json().then(data => ({ status: response.status, body: data })))
                        .then(({ status, body }) => {
                            if (status === 200 && body.success) {
                                Swal.fire('Başarılı!', body.message, 'success').then(() => {
                                    location.reload(); // Ağacı yenilemek için sayfayı yeniden yükle
                                });
                            } else {
                                throw new Error(body.message || 'Bir hata oluştu.');
                            }
                        })
                        .catch(error => {
                            Swal.fire('Hata!', error.message, 'error');
                        });
                    }
                });
            });

            uploadBtn.addEventListener('click', function() {
                if (!currentSelectedPath) {
                    Swal.fire('Hata', 'Lütfen dosyanın yükleneceği bir konum (klasör veya dosya) seçin.', 'error');
                    return;
                }
                fileUploadInput.click(); // Gizli input'u tetikle
            });

            fileUploadInput.addEventListener('change', function() {
                if (this.files.length === 0) return; // Kullanıcı dosya seçmekten vazgeçti
                
                const file = this.files[0];
                let uploadPath = '';

                if (currentSelectedNodeType === 'file') {
                    // Eğer bir dosya seçiliyse, o dosyanın bulunduğu klasöre yükle
                    uploadPath = currentSelectedPath.substring(0, currentSelectedPath.lastIndexOf('/'));
                } else { // 'folder'
                    // Eğer bir klasör seçiliyse, o klasörün içine yükle
                    uploadPath = currentSelectedPath;
                }

                if (!uploadPath) {
                    Swal.fire('Hata', 'Geçerli bir yükleme konumu belirlenemedi.', 'error');
                    return;
                }

                const formData = new FormData();
                formData.append('file', file);
                formData.append('path', uploadPath);
                formData.append('__RequestVerificationToken', '@Xsrf.GetAndStoreTokens(Context).RequestToken');

                Swal.fire({
                    title: 'Yükleniyor...',
                    text: `'${file.name}' dosyası '${uploadPath}' konumuna yükleniyor.`,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                fetch('/Dizgem/ThemeEditor/UploadFile', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json().then(data => ({ status: response.status, body: data })))
                .then(({ status, body }) => {
                    if (status === 200 && body.success) {
                        Swal.fire('Başarılı!', body.message, 'success').then(() => {
                            location.reload(); 
                        });
                    } else {
                        throw new Error(body.message || 'Bir hata oluştu.');
                    }
                })
                .catch(error => {
                    Swal.fire('Hata!', error.message, 'error');
                });

                // Input'u sıfırla ki aynı dosyayı tekrar seçebilsin
                this.value = null;
            });

        });
    </script>
}
